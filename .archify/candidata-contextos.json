      "title": "Correlaciones registradas",
      "items": [
        "grupo ↔ capacidad: `vault_servicio --trace` (SERVICIO en scripts/vault_servicio.py)",
        "estado ↔ régimen de versionado: STATUS_TRANSITIONS en vault_norms (IV)",
        "versión ↔ contrato de nota: HISTORIA en vault/kernel/contrato_nota.py (I)",
        "clase de documento ↔ ejes: EJES_DOCUMENTACION en vault_registry (I)"
      ]
    },
    {
      "dot": "violet",
      "title": "Pertenencia (176 módulos en los diez contextos)",
      "items": [
        "I Kernel 23 · II Autoría 46 · III Grafo 15 · IV Gobernanza 13 · V Índices 7",
        "VI Consulta 11 · VII Ciclo 10 · VIII Durabilidad 4 · IX Meta-toolkit 39 · X CLI 8",
        "claves romanas: orden de CONTEXTS en scripts/vault_arch.py"
      ]
    },
    {
      "dot": "rose",
      "title": "Límites (prohibe) declarados",
      "items": [
        "I Kernel: no depende de ningún dominio",
        "VI Consulta: sin base de datos · sin embeddings · sin servicio externo",
        "VIII Durabilidad: no escribir fuera de la raíz (AP-36)",
        "IX Meta-toolkit: no escribe en sección de contenido",
        "X CLI: no decide; traduce argumento a llamada y envelope a salida"
      ]
    },
    {
      "dot": "emerald",
      "title": "Vocabularios con dueño",
      "items": [
        "status (12 valores) → STATUS_VOCAB en vault_norms (IV)",
        "causas de fallo de dominio → CAUSAS en vault/kernel/fallos.py (I)",
        "sección por clase de doc → SECTION_DOCUMENTACION en vault_registry (I)",
        "entorno declarado → VARIABLES en vault/kernel/entorno.py (I)"
      ]
    }
  ]
