
__pycache__/
*.pyc

# Vault runtime content — este repo es spec, no vault
# Los scripts redirigen contenido a vault-sandbox/ cuando detectan el repo spec
# (ver _detect_vault_root en vault_io.py)
vault-sandbox/
00_System/

# Excepción: el contrato de tools vive en <vault>/00_System/ desde v39 (AP-36),
# y en este repo el vault es vault-sandbox/. Es fuente de verdad de los
# contratos y de la generación del catálogo MCP, así que debe seguir versionado.
# Git no re-incluye un archivo si un directorio padre está excluido: hay que
# des-ignorar la cadena de directorios y volver a excluir su contenido.
!vault-sandbox/
vault-sandbox/*
!vault-sandbox/00_System/
vault-sandbox/00_System/*
!vault-sandbox/00_System/tool-spec.json
01_Projects/
02_Observability/
03_Decisions/
04_Sessions/
05_Patterns/
06_Diagrams/
07_Knowledge/
08_Runbooks/
09_Infrastructure/
10_Migrated/
11_Code/
12_Bibliography/
13_Flows/
14_Requirements/
15_Tests/
16_AI_Governance/
17_Preferences/
99_Index/
.history/
vault-backups/
.vault-fix-backup-*/
# Estado local del agente. Excepción: .claude/skills/ SON parte del estándar —
# la definición de una skill es tan canónica como su entry point en scripts/.
# vault-sdd-init sobrevivía solo por haberse trackeado antes de esta regla:
# cualquier skill NUEVA quedaba fuera del repo en silencio, y con ella el
# contrato que verifica tests/test_skills_contract.py.
.claude/*
!.claude/skills/
debug_brackets.py

# Análisis local, no forma parte del estándar
ANALISIS-HISTORICO-manifiesto.md

# Backups locales de otros proyectos — no forman parte del estándar
_backups-builderx/

# Datasets de análisis — copias de vaults reales de otros proyectos.
# NUNCA se versionan: son datos del usuario, ajenos al estándar, y contienen
# material sensible (notas de proyectos privados, credenciales en runbooks,
# datos de clientes). Se copian aquí solo para estudiar cómo se degradan los
# vaults en uso real y volcar esas conclusiones en normas.
_datasets/
_datasets-reports/

# Artefacto de coverage.py: salida de una ejecucion local, no del estandar.
.coverage
