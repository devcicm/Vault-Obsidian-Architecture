{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vault-v21.schema.json",
  "title": "Frontmatter de una nota — estándar v21",
  "description": "Generado por vault_esquema desde vault_contrato_nota; no se edita a mano. La raíz es el contrato de una nota de contenido; las de 00_System/ usan #/$defs/sistema.",
  "x-vault-version": "v21",
  "x-vault-validador": false,
  "x-vault-origen": "manifiesto",
  "x-vault-indices-exentos": false,
  "x-vault-recomendados": [],
  "x-vault-historia": [
    {
      "campos": [
        "id",
        "title",
        "type",
        "createdAt",
        "updatedAt",
        "tags"
      ],
      "cambio": "AP-12 en el manifiesto: los seis campos obligatorios en toda nota; ninguna tool lo aplica",
      "fuente": "manifiesto:974c2ba:Los campos obligatorios (`id`, `title`, `type`, `createdAt`, `updatedAt`, `tags`)"
    },
    {
      "campos": [
        "agent"
      ],
      "cambio": "el escritor pone agent en las notas nuevas",
      "fuente": "MIGRATIONS:AP-16: add agent: field to new notes"
    }
  ],
  "type": "object",
  "required": [
    "id",
    "title",
    "createdAt",
    "updatedAt",
    "tags",
    "type"
  ],
  "properties": {
    "id": {
      "x-vault-tipo-esperado": "string",
      "x-vault-nivel": "requerido",
      "x-vault-norma": "AP-12"
    },
