{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vault-v25.schema.json",
  "title": "Frontmatter de una nota — estándar v25",
  "description": "Generado por vault_esquema desde vault_contrato_nota; no se edita a mano. La raíz es el contrato de una nota de contenido; las de 00_System/ usan #/$defs/sistema.",
  "x-vault-version": "v25",
  "x-vault-validador": true,
  "x-vault-indices-exentos": false,
  "x-vault-recomendados": [],
  "x-vault-historia": [
    {
      "campos": [
        "agent"
      ],
      "cambio": "el escritor pone agent en las notas nuevas",
      "fuente": "MIGRATIONS:AP-16: add agent: field to new notes"
    },
    {
      "campos": [
        "id",
        "title"
      ],
      "cambio": "primer validador: id y title obligatorios",
      "fuente": "git:767a84a"
    }
  ],
  "type": "object",
  "required": [
    "id",
    "title"
  ],
  "properties": {
    "id": {
      "x-vault-tipo-esperado": "string",
      "x-vault-nivel": "requerido",
      "x-vault-norma": "AP-12"
    },
    "title": {
      "x-vault-tipo-esperado": "string",
      "x-vault-nivel": "requerido",
      "x-vault-norma": "AP-12"
    },
    "agent": {
      "x-vault-tipo-esperado": "string",
      "x-vault-nivel": "requerido",
      "x-vault-norma": "AP-16"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "contenido": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "x-vault-tipo-esperado": "string",
          "x-vault-nivel": "requerido",
          "x-vault-norma": "AP-12"
        },
        "title": {
          "x-vault-tipo-esperado": "string",
          "x-vault-nivel": "requerido",
          "x-vault-norma": "AP-12"
        },
        "agent": {
          "x-vault-tipo-esperado": "string",
          "x-vault-nivel": "requerido",
          "x-vault-norma": "AP-16"
        }
      },
      "additionalProperties": true
    },
    "sistema": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "x-vault-tipo-esperado": "string",
          "x-vault-nivel": "requerido",
          "x-vault-norma": "AP-12"
        },
        "title": {
          "x-vault-tipo-esperado": "string",
          "x-vault-nivel": "requerido",
          "x-vault-norma": "AP-12"
        },
        "agent": {
          "x-vault-tipo-esperado": "string",
          "x-vault-nivel": "requerido",
          "x-vault-norma": "AP-16"
        }
      },
      "additionalProperties": true
    }
  }
}
