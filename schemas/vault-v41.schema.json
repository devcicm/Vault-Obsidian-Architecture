{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vault-v41.schema.json",
  "title": "Frontmatter de una nota — estándar v41",
  "description": "Generado por vault_esquema desde vault_contrato_nota; no se edita a mano. La raíz es el contrato de una nota de contenido; las de 00_System/ usan #/$defs/sistema. Un .md fuera de toda sección usa #/$defs/sin_seccion.",
  "x-vault-version": "v41",
  "x-vault-validador": true,
  "x-vault-origen": "validador",
  "x-vault-indices-exentos": true,
  "x-vault-recomendados": [],
  "x-vault-historia": [
    {
      "campos": [
        "id",
        "title",
        "type",
        "createdAt",
        "updatedAt",
        "tags"
      ],
      "cambio": "AP-12 en el manifiesto: los seis campos obligatorios en toda nota; ninguna tool lo aplica",
      "fuente": "manifiesto:974c2ba:Los campos obligatorios (`id`, `title`, `type`, `createdAt`, `updatedAt`, `tags`)"
    },
    {
      "campos": [
        "agent"
      ],
      "cambio": "el escritor pone agent en las notas nuevas",
      "fuente": "MIGRATIONS:AP-16: add agent: field to new notes"
    },
    {
      "campos": [
        "id",
        "title"
      ],
      "cambio": "primer validador: exige id y title, menos que AP-12, que el manifiesto de v25 sigue escribiendo igual",
      "fuente": "git:767a84a"
    },
    {
      "campos": [
        "cia_integrity",
        "cia_availability",
        "cia_sensitivity",
        "agent",
        "dq_validated_at"
      ],
      "cambio": "si están, el valor CIA pertenece al vocabulario y agent no está vacío",
      "fuente": "MIGRATIONS:vault_validate: CIA field validation + agent field validation"
    },
    {
      "campos": [
        "cia_integrity",
        "cia_availability",
        "cia_sensitivity",
        "agent"
      ],
      "cambio": "los scripts de escritura ponen CIA y agent",
      "fuente": "MIGRATIONS:CIA frontmatter obligatorio en 12 scripts de escritura"
    },
    {
      "campos": [
        "status"
      ],
      "cambio": "vocabulario de status auditado (CN-03)",
      "fuente": "MIGRATIONS:status vocabulary"
    },
    {
      "campos": [
        "createdAt",
        "updatedAt",
        "cia_integrity",
        "cia_availability",
        "cia_sensitivity",
        "agent",
        "tags"
      ],
      "cambio": "requeridos; CIA, agent y tags solo en notas de contenido, y los índices quedan fuera del contrato. type y status, recomendados",
      "fuente": "git:f1fc051"
    },
    {
      "campos": [
        "type",
        "status"
      ],
      "cambio": "el escritor los pone por defecto y vault_audit penaliza su ausencia",
      "fuente": "git:f1fc051"
    },
    {
      "campos": [
        "type",
        "status"
      ],
      "cambio": "requeridos en notas de contenido, por presencia: el valor lo sigue juzgando vault_audit",
      "fuente": "MIGRATIONS:AP-27/AP-29: type y status requeridos en notas de contenido"
    },
    {
      "campos": [
        "id",
        "title",
        "createdAt",
        "updatedAt"
      ],
      "cambio": "clase sin_seccion: un .md fuera de toda sección lleva identidad y timestamps; CIA, agent, tags, type y status son de las notas de sección",
      "fuente": "MIGRATIONS:clase sin_seccion: un .md fuera de toda seccion"
    },
    {
      "campos": [
        "vigente_desde"
      ],
      "cambio": "opcional: la versión del proyecto desde la que rige una nota de arquitectura; el fin sale de superseded_by o del status",
      "fuente": "MIGRATIONS:vigente_desde (opcional): version del proyecto"
    },
    {
      "campos": [
        "responsable",
        "revisado_en"
      ],
      "cambio": "opcionales: quién responde del contenido y cuándo se comprobó por última vez; si están, responsable no vacío y revisado_en con fecha ISO",
      "fuente": "MIGRATIONS:responsable y revisado_en (opcionales)"
    }
  ],
